{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": false },
	"files": {
		"ignoreUnknown": false,
		"ignore": [
			"node_modules",
			".next",
			".swc",
			".vscode",
			"coverage",
			"dist",
			"public"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"ignore": [
			"node_modules",
			".next",
			".swc",
			".vscode",
			"coverage",
			"dist",
			"public"
		]
	},
	"organizeImports": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": { "recommended": false },
		"ignore": [
			"node_modules",
			".next",
			".swc",
			".vscode",
			"coverage",
			"dist",
			"public"
		]
	},
	"javascript": { "formatter": { "quoteStyle": "double" } }
}
